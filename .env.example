# Mahjong Practice Table configuration

# Groq (coach LLM provider)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
# Long random string; signs the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# Lax for a direct link; None (requires HTTPS) when the page is embedded in an iframe
COOKIE_SAMESITE=Lax

# Game
GAME_DB_PATH=games.sqlite3
CARD_FILE=cards/practice_card.json
RULES_FILE=rules/practice_rules.md
COACH_MAX_MESSAGES=40
GAME_TTL_HOURS=24

# CORS (comma-separated origins allowed to call the API; empty = same origin only)
ALLOWED_ORIGINS=

LOG_LEVEL=INFO
